# ============================================================
# AI PROVIDERS — BẮT BUỘC (chọn 1 hoặc cả 2)
# ============================================================

# GROQ — KHUYẾN NGHỊ ⭐⭐⭐ — 14,400 lượt/ngày MIỄN PHÍ
# Dùng cho: Tạo đề AI + OCR DOCX/PDF văn bản
# Đăng ký tại: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_key_here

# GEMINI — Cần cho OCR ảnh/PDF scan
# Dùng cho: OCR ảnh chụp, PDF scan
# 1,000 lượt/ngày MIỄN PHÍ — Lấy tại: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_key_here

# ============================================================
# SUPABASE — TÙY CHỌN (không có vẫn dùng được = Local Mode)
# ============================================================
# Chỉ cần nếu muốn: đăng nhập cloud, đồng bộ dữ liệu nhiều thiết bị
# Lấy tại: https://supabase.com/dashboard → Settings → API
#
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
